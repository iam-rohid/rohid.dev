---
interface Props {
  image: string;
  title: string;
  description: string;
  link: string;
  linkText: string;
}

const { image, title, description, link, linkText } = Astro.props;
---

<div
  class="bg-background dark:bg-secondary/50 relative my-6 flex h-fit overflow-hidden rounded-xl border shadow-sm max-sm:flex-col"
>
  <div class="relative w-full max-sm:h-48 sm:w-64">
    <img
      src={image}
      alt={title}
      class="absolute inset-0 m-0! h-full w-full object-cover"
    />
    <div
      class="absolute bottom-1 left-1 rounded-md bg-black/50 px-2 py-0.5 text-sm text-white/80"
    >
      Ad
    </div>
  </div>
  <div class="flex-1 p-4">
    <h3 class="mt-0 mb-2 text-lg font-semibold">
      {title}
      <a
        href={link}
        class="absolute inset-0 focus:outline"
        target="_blank"
        rel="nofollow"></a>
    </h3>
    <p class="text-muted-foreground mb-4 text-sm leading-relaxed">
      {description}
    </p>
    <a
      href={link}
      class="text-primary hover:text-primary/80 relative mt-0 mb-0 inline-block text-sm no-underline underline-offset-2 hover:underline"
      target="_blank"
      rel="nofollow">{linkText}</a
    >
  </div>
</div>
